{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nihao:schema:entities.schema.json",
  "title": "Nihao entities",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "domain": {
      "enum": [
        "entry_visa",
        "daily_life",
        "attractions",
        "food_culture",
        "transportation"
      ]
    },
    "scope": {
      "enum": [
        "national",
        "province",
        "city",
        "poi"
      ]
    },
    "province": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "license": {
      "type": "string"
    },
    "rights_status": {
      "enum": [
        "approved",
        "metadata_only",
        "needs_review",
        "withdrawn"
      ]
    },
    "content_status": {
      "type": "string"
    },
    "data_version": {
      "type": "string"
    },
    "name_zh": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "aliases": {
      "type": "array"
    },
    "entity_type": {
      "type": "string"
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "qid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^Q[1-9][0-9]*$"
    },
    "osm_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "external_ids": {
      "type": "object"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1
    },
    "raw_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalization_version": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "entity_id",
    "domain",
    "scope",
    "province",
    "city",
    "language",
    "source_id",
    "source_url",
    "fetched_at",
    "source_published_at",
    "last_verified_at",
    "license",
    "rights_status",
    "content_status",
    "data_version",
    "name_zh",
    "name_en",
    "aliases",
    "entity_type",
    "latitude",
    "longitude",
    "qid",
    "osm_id",
    "external_ids",
    "source_ids",
    "provenance"
  ],
  "additionalProperties": true
}
