# Set POE_API_KEY, DOUBAO_API_KEY and BAIDU_MAP_API_KEY in your shell
# (`poe`, `doubao` and `baidumap` locally). Never add server keys to VITE_ variables.
# This example contains no credential. The app reads inherited environment variables.
POE_MODEL=gpt-5.4-mini
POE_BASE_URL=https://api.poe.com/v1
PORT=8787
# Optional Doubao read-aloud settings; the API key is supplied via the environment.
DOUBAO_SPEAKER=zh_female_vv_uranus_bigtts
# Microphone dictation uses the same DOUBAO_API_KEY, with ASR 2.0 enabled.
ASR_TIMEOUT_MS=140000
ASR_MAX_CONCURRENT=2
