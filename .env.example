# Copy this file to .env in the project root and fill in the three keys.
# npm start / npm run dev / npm run env:check load .env automatically.
# Existing exported environment variables take priority over .env.
# Keep .env private; it is ignored by Git. Never use VITE_ names for server keys.
POE_API_KEY=""
# Server-type Baidu Maps AK with MCP service access.
BAIDU_MAP_API_KEY=""
# Enable TTS 2.0 and streaming ASR 2.0 for this Doubao key.
DOUBAO_API_KEY=""

POE_MODEL=gpt-5.4-mini
POE_BASE_URL=https://api.poe.com/v1
PORT=8787
# Optional Doubao read-aloud settings.
DOUBAO_SPEAKER=zh_female_vv_uranus_bigtts
# Microphone dictation uses the same DOUBAO_API_KEY, with ASR 2.0 enabled.
ASR_TIMEOUT_MS=140000
ASR_MAX_CONCURRENT=2
